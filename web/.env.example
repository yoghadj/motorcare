# Database (Neon PostgreSQL)
# Use the pooled URL for serverless (Vercel). Get from Neon dashboard → Connection string.
# Optional: add &connect_timeout=15 for serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: direct (unpooled) URL for migrations / long-running scripts
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST-UNPOOLED/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Admin seeder (optional; used by db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"
